  <!--
    Папка установки AutoCAD/Civil 3D 2024.
    Прежние HintPath были относительными и ломались при переносе проекта на другой
    диск. Теперь путь ищется перебором; при необходимости задайте свой:
    msbuild /p:AcadDir="X:\...\AutoCAD 2024\"  (обязательно со слешем в конце).
  -->
  <PropertyGroup>
    <AcadDir Condition=" '$(AcadDir)' == '' AND Exists('D:\Apps\AutoCAD\AutoCAD 2024\acdbmgd.dll') ">D:\Apps\AutoCAD\AutoCAD 2024\</AcadDir>
    <AcadDir Condition=" '$(AcadDir)' == '' AND Exists('C:\Program Files\Autodesk\AutoCAD 2024\acdbmgd.dll') ">C:\Program Files\Autodesk\AutoCAD 2024\</AcadDir>
    <AcadDir Condition=" '$(AcadDir)' == '' ">..\..\..\..\..\..\..\Program Files\Autodesk\AutoCAD 2024\</AcadDir>
  </PropertyGroup>
  <Target Name="CheckAcadDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition=" !Exists('$(AcadDir)acdbmgd.dll') "
           Text="Не найдена установка AutoCAD 2024 по пути '$(AcadDir)'. Задайте её свойством AcadDir." />
  </Target>
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
